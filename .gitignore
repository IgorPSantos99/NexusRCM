# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.py,cover

# Python tooling
.python-version

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches and reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Environment files
.env
.env.*
*.key, 
*.pem
!.env.example

