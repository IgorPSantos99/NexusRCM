#!/usr/bin/env sh

if [ -x ".venv/bin/python" ]; then
  PYTHON_BIN=".venv/bin/python"
elif [ -x ".venv/Scripts/python.exe" ]; then
  PYTHON_BIN=".venv/Scripts/python.exe"
else
  echo "Missing project virtual environment."
  echo "Expected .venv/bin/python on Linux/macOS or .venv/Scripts/python.exe on Windows."
  echo "Create it first and install dev dependencies."
  exit 1
fi

export PYTHON_BIN

